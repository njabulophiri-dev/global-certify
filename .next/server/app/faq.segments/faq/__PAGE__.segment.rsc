8:["$","section",null,{"className":"py-16 lg:py-24 bg-white","children":["$","div",null,{"className":"container-custom","children":["$","div",null,{"className":"max-w-3xl mx-auto space-y-6","children":[["$","div","0",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"How long does the application process take?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Typically 3–6 months from initial consultation to admission letter. Scholarship (Quota) applications have specific deadlines set by the Russian Government, usually closing in January for September intake. We keep you on track so nothing slips through the cracks."}]]}],["$","div","1",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"Is my degree recognised in South Africa?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Yes — with proper planning. Medical graduates need HPCSA registration. Engineering graduates need ECSA evaluation. We guide you through this process from day one, not as an afterthought. Recognition is a strategy, not a surprise."}]]}],["$","div","2",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"Do I need to speak Russian before I go?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Not necessarily. Many programs offer preparatory Russian language courses. We provide pre-departure language support and connect you with resources to hit the ground running. Survival Russian is enough to start; academic Russian comes with time."}]]}],["$","div","3",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"What if I struggle academically or personally?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Our student support team can help with wellness and in-country logistics. We check in regularly, provide support, and help address challenges before small issues become big problems. We're not ghosting you after arrival."}]]}],["$","div","4",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"Are there really no hidden fees?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Really. Our scholarship guidance is completely free. For full-service packages, we publish every cost upfront. The only surprise we believe in is how smooth the process can actually be when done right."}]]}],["$","div","5",{"className":"card p-8","children":[["$","h3",null,{"className":"text-lg font-bold text-navy-900 mb-3","children":"Can parents be involved in the process?"}],["$","p",null,{"className":"text-navy-600 leading-relaxed","children":"Absolutely. We encourage it. We provide regular updates, clear timelines, and direct contact channels. Parents often have the best questions — and we have the answers. You're not handing your child to strangers; you're partnering with people who've walked the same path."}]]}]]}]}]}]
